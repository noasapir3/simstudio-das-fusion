{
  "_description": "Demo: every supported anomaly class in one simulation.  Four parallel 800 m one-way roads stacked top-to-bottom (20 m apart).  Designed so all anomaly events fire within the first ~12 seconds and remain visually clear for at least 30 s.",
  "_demo_layout": {
    "road_NORTH      (y=+30, lane Snorth_fwd_lane1)": "weaving lane",
    "road_MIDDLE     (y=+10, lane Smiddle_fwd_lane1)": "obstacle + braking chain",
    "road_SOUTH      (y=-10, lane Ssouth_fwd_lane1)": "collision pair",
    "road_FAR_SOUTH  (y=-30, lane Sfarsouth_fwd_lane1)": "route-complete + normal cruiser"
  },
  "_demo_timeline": [
    "t=0.0  WEAVER (NORTH) oscillates +/-2.5 m at 4 s period \u2014 visible immediately.",
    "t=0.0  OBSTACLE_PED (MIDDLE, s=300) is a stationary pedestrian (yellow diamond).",
    "t=0.0  STOPPER (MIDDLE, s=80, v=22.2) approaches the pedestrian.",
    "t=0.0  TAILBACK (MIDDLE, s=20, v=22.2) follows STOPPER 60 m behind.",
    "t=0.0  WALL (SOUTH, s=160, v=0, frozen) is a stalled car.",
    "t=0.0  CRASHER (SOUTH, s=20, v=22.2, allow_collision+disable_idm) drives at WALL.",
    "t=0.0  ROUTE_DEMO (FAR_SOUTH, s=80, v=10) has a planned route to s=180.",
    "t=0.0  CRUISER (FAR_SOUTH, s=300, v=15) drives normally \u2014 visual baseline.",
    "t~6.3  CRASHER hits WALL \u2014 both gain a red warning triangle (one collision event).",
    "t~10.0 STOPPER stops cleanly behind OBSTACLE_PED \u2014 IDM braking, no marker.",
    "t~10.0 ROUTE_DEMO reaches s=180 \u2014 gains the blue X (world.route_complete).",
    "t~12.0 TAILBACK has fully stopped behind STOPPER (chain stop, no marker).",
    "t~30+  CRUISER continues normally; WEAVER continues weaving."
  ],
  "_demo_visual_legend": {
    "yellow_diamond_with_exclamation": "Road obstacle (Vehicle.object_type != 'vehicle').",
    "red_warning_triangle": "Collision marker (world.collision event).  Drawn on BOTH vehicles in the pair.",
    "blue_X": "Vehicle completed its planned route (world.route_complete).",
    "blue_rectangle": "Normal vehicle, fill darker for heavier vehicles.",
    "no_special_marker_when_stopped": "A stopped non-obstacle vehicle stays a regular blue rectangle but still acts as a physical IDM leader."
  },
